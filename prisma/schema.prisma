// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DINKES
  PUSKESMAS
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String
  role            Role              @default(PUSKESMAS)
  puskesmasCode   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sessions        Session[]
  nakesSubmissions NakesSubmission[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Pengajuan kebutuhan nakes dari Puskesmas (atau entri oleh Dinkes atas nama Puskesmas).
/// Setiap upload menghasilkan satu record NakesSubmission baru; record lama dari puskesmas
/// yang sama tetap tersimpan sebagai riwayat. Dashboard selalu membaca submission terbaru
/// per puskesmasCode.
model NakesSubmission {
  id            String                @id @default(cuid())
  puskesmasCode String                // Kode puskesmas target (misal: "purwokerto_barat")
  submittedById String                // User yang melakukan submit
  submittedBy   User                  @relation(fields: [submittedById], references: [id])
  submittedAt   DateTime              @default(now())
  items         NakesSubmissionItem[]

  @@index([puskesmasCode, submittedAt])
}

/// Rincian satu jenis nakes dalam satu pengajuan.
model NakesSubmissionItem {
  id           String          @id @default(cuid())
  submissionId String
  submission   NakesSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  jenisNakes   String          // Nama profesi, mis. "Dokter", "Perawat"
  kebutuhan    Int             // Jumlah yang dibutuhkan (diajukan oleh Puskesmas)
  tersedia     Int             @default(0) // Jumlah yang sudah tersedia saat pengajuan
}
